# ######### 基础配置 #########
# 服务器的对外IP地址
EXTERNAL_IP=your_server_ip

# mysql root用户的密码
MYSQL_ROOT_PASSWORD=your_mysql_password

# mysql默认数据库名字
MYSQL_DATABASE=im

# ######### Minio文件服务配置 #########
# minio文件服务的用户名
MINIO_ROOT_USER=minio

# minio文件服务的密码
MINIO_ROOT_PASSWORD=your_minio_password

######### WuKongIM相关的配置 #########
# 模式 debug or release
WK_MODE=release

# 开启最近会话服务端维护
WK_CONVERSATION_ON=true

# 业务服务的grpc地址
WK_WEBHOOK_GRPCADDR=tangsengdaodaoserver:6979

# 业务服务的数据源地址
WK_DATASOURCE_ADDR=http://tangsengdaodaoserver:8090/v1/datasource

# 开启频道信息同步
WK_DATASOURCE_CHANNELINFOON=true

# 开启token认证
WK_TOKENAUTHON=true

# 是否关闭个人白名单功能
WK_WHITELISTOFFOFPERSON=false

# JWT的密钥（请修改为随机字符串）
WK_JWT_SECRET=your_jwt_secret_here

######### TangSengDaoDao的配置 #########
# 模式 debug or release
TS_MODE=release

# wukongim的内网访问地址
TS_WUKONGIM_APIURL=http://wukongim:5001

# redis连接地址
TS_DB_REDISADDR=redis:6379

# 验证码（固定验证码，方便测试；生产环境建议接入短信服务商）
# 生产环境请改为真实短信服务配置
TS_SMSCODE=123456

# 使用文件服务的类型
TS_FILESERVICE=minio

# 默认头像获取地址
TS_AVATAR_DEFAULTBASEURL=https://api.dicebear.com/8.x/avataaars/png?seed={avatar}&size=180

# 唐僧叨叨后台管理系统的管理员密码，用户名为 superAdmin
TS_ADMINPWD=your_admin_password

# 唐僧叨叨的文件服务地址
TS_MINIO_UPLOADURL=http://minio:9000
