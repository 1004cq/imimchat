# CQIM env template. Copy to .env. Do not commit secrets.

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://wed.imim.chat
CORS_ORIGINS=https://wed.imim.chat,http://wed.imim.chat

# Prisma 主库 = PostgreSQL（compose 默认连本机 postgres 服务；生产填腾讯云内网）
# 禁止 mongodb:// 与 file:*.db。Mongo 不是 Prisma 主库。
DATABASE_URL=postgresql://cqim:cqim@127.0.0.1:5432/cqim?schema=public
POSTGRES_USER=cqim
POSTGRES_PASSWORD=cqim
POSTGRES_DB=cqim

REDIS_URL=redis://redis:6379
REDIS_PORT=6379

MYSQL_URL=mysql://cqim:cqim@mysql:3306/cqim_audit
MYSQL_AUDIT_ENABLED=true

GATEWAY_ID=gw-app-1
REDIS_ADDR=redis:6379

APPLE_TEAM_ID=4U332QFN6D
APPLE_BUNDLE_ID=com.imim.chat

TRTC_SDK_APP_ID=1600159677
TRTC_SECRET_KEY=
