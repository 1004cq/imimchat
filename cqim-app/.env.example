# Copy this file to .env, then fill secrets before starting:
#   cp .env.example .env
# Compose interpolates this file. Empty MINIO_ROOT_* will refuse to start.
#
# Required to start:
#   DATABASE_URL (postgresql://... — never file:./dev.db)
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   REDIS_URL
#   MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (required, non-empty)
#   PUBLIC_BASE_URL / CORS_ORIGINS
#
# Fill before production push / calls (optional for a local compose boot):
#   APNS_*   WEB_PUSH_*   TRTC_*
#
# Never commit a real APNs P8 private key. Keep APNS_P8_KEY in the host .env only.

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://im.cq.je
CORS_ORIGINS=https://im.cq.je,http://im.cq.je

# Prisma 主库 = PostgreSQL（compose 服务名 postgres）
DATABASE_URL=postgresql://cqim:cqim@postgres:5432/cqim?schema=public
POSTGRES_USER=cqim
POSTGRES_PASSWORD=cqim
POSTGRES_DB=cqim

REDIS_URL=redis://redis:6379
GATEWAY_ID=gw-app-1
REDIS_ADDR=redis:6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Required by compose; replace both values before deployment.
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password-at-least-16-chars
MINIO_BUCKET=cqim-media
MINIO_REGION=us-east-1
MEDIA_MAX_VIDEO_BYTES=104857600

APPLE_TEAM_ID=4U332QFN6D
APPLE_BUNDLE_ID=com.imim.chat
# P8 私钥只通过环境变量注入，不写入数据库、镜像或 Git
APNS_KEY_ID=
APNS_P8_KEY=
# 仅当设备 Token 没有携带 environment 时使用；Token 自身的 environment 优先
APNS_PRODUCTION=false

# Web Push VAPID
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:security@imim.chat

TRTC_SDK_APP_ID=1600159677
TRTC_SECRET_KEY=
