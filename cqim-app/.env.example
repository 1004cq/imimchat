# Copy to .env. Do not commit secrets.

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://wed.imim.chat
CORS_ORIGINS=https://wed.imim.chat,http://wed.imim.chat

# Prisma 主库 = PostgreSQL
DATABASE_URL=postgresql://cqim:cqim@postgres:5432/cqim?schema=public
POSTGRES_USER=cqim
POSTGRES_PASSWORD=cqim
POSTGRES_DB=cqim

REDIS_URL=redis://redis:6379
GATEWAY_ID=gw-app-1
REDIS_ADDR=redis:6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=cqimminio
MINIO_ROOT_PASSWORD=cqimio-secret-change-me
MINIO_BUCKET=cqim-media
MINIO_REGION=us-east-1
MEDIA_MAX_VIDEO_BYTES=104857600

APPLE_TEAM_ID=4U332QFN6D
APPLE_BUNDLE_ID=com.imim.chat
# P8 私钥只通过环境变量注入，不写入数据库或镜像
APNS_KEY_ID=
APNS_P8_KEY=

# Web Push VAPID
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:security@imim.chat

TRTC_SDK_APP_ID=1600159677
TRTC_SECRET_KEY=
