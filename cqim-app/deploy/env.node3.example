# 节点3（103.24.217.244）接入双节点集群
NODE_ENV=production
PORT=3000

PUBLIC_BASE_URL=https://wed.imim.chat
CORS_ORIGINS=https://wed.imim.chat,http://wed.imim.chat

# 与 node1/node2 相同的共享 SQLite（NFS 挂载路径）
DATABASE_URL=file:/app/data/cqim.db
SHARED_DATA_DIR=/home/ubuntu/cqim_shared/data

# 节点1 Redis（6380 已对节点3 开放）
NODE1_HOST=42.194.167.201
REDIS_URL=redis://42.194.167.201:6380
REDIS_ADDR=42.194.167.201:6380
REDIS_PASSWORD=
REDIS_DB=0

# 第三台 Gateway，必须唯一
GATEWAY_ID=gw-app-3

# 必须与 node1 .env 中 JWT_SECRET 完全一致
JWT_SECRET=REPLACE_WITH_NODE1_JWT_SECRET
