# 单机独立部署环境变量（复制到 cqim-app/.env）
NODE_ENV=production
PORT=3000

# 使用服务器 IP 或后续绑定的域名
PUBLIC_BASE_URL=http://103.24.217.244:999
CORS_ORIGINS=http://103.24.217.244:999

DATABASE_URL=file:/app/data/cqim.db
REDIS_URL=redis://redis:6379
MYSQL_AUDIT_ENABLED=false

GATEWAY_ID=gw-standalone-1
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 生产请自行生成随机密钥
JWT_SECRET=change-me-standalone-jwt-secret
