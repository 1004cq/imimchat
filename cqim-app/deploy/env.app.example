# 节点2 应用节点环境变量示例
# 复制为 .env 后替换 NODE1_HOST / TENCENT_PG_* 为实际内网地址

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://wed.imim.chat
CORS_ORIGINS=https://wed.imim.chat,http://wed.imim.chat

# Prisma 主库 = 腾讯云 PostgreSQL 内网。禁止 file:*.db / mongodb://
# Mongo 不是 Prisma 主库，不要把 mongo URL 填进 DATABASE_URL。
# 禁止 NFS 共享 .db 跨机器。两节点必须连同一 PG。
DATABASE_URL=postgresql://USER:PASS@TENCENT_PG_HOST:5432/cqim?schema=public

# 节点1 Redis（生产环境 Docker 映射在 6380，仅对节点2 开放）
REDIS_URL=redis://NODE1_HOST:6380
REDIS_ADDR=NODE1_HOST:6380
REDIS_PASSWORD=
REDIS_DB=0

# 每台 Gateway 必须唯一
GATEWAY_ID=gw-app-2

# 媒体等文件目录（不是 Prisma 库；不要把 cqim.db 放这里当主库）
SHARED_DATA_DIR=/home/ubuntu/cqim_shared/data
