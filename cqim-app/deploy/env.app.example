# 节点2 应用节点环境变量示例
# 复制为 .env 后替换 NODE1_HOST 为节点1 内网或公网 IP（节点2 能连通即可）

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://im.cq.je
CORS_ORIGINS=https://im.cq.je,http://im.cq.je

# 共享 PostgreSQL（由数据节点提供）
DATABASE_URL=postgresql://cqim:cqim@NODE1_HOST:5432/cqim?schema=public

# 节点1 Redis（生产环境 Docker 映射在 6380，仅对节点2 开放）
REDIS_URL=redis://NODE1_HOST:6380
REDIS_ADDR=NODE1_HOST:6380
REDIS_PASSWORD=
REDIS_DB=0

# 节点1 MinIO（默认 API 端口 9000，仅内网开放）
MINIO_ENDPOINT=NODE1_HOST
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=cqimminio
MINIO_ROOT_PASSWORD=cqimio-secret-change-me
MINIO_BUCKET=cqim-media
MINIO_REGION=us-east-1

# 每台 Gateway 必须唯一
GATEWAY_ID=gw-app-2

# NFS 共享数据目录（宿主机路径，供 docker-compose.app.yml 挂载）
SHARED_DATA_DIR=/home/ubuntu/cqim_shared/data
