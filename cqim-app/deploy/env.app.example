# 节点2 应用节点环境变量示例
# 复制为 .env 后替换 NODE1_HOST 为节点1 内网或公网 IP（节点2 能连通即可）

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://wed.imim.chat
CORS_ORIGINS=https://wed.imim.chat,http://wed.imim.chat

# Prisma/API 主库 = PostgreSQL。禁止 file:/app/data/cqim.db（NFS 共享 sqlite 已禁止）。
# 禁止把 Mongo URL 填进 DATABASE_URL。
DATABASE_URL=postgresql://USER:PASS@NODE1_HOST:5432/cqim?schema=public

# 节点1 Redis（生产环境 Docker 映射在 6380，仅对节点2 开放）
REDIS_URL=redis://NODE1_HOST:6380
REDIS_ADDR=NODE1_HOST:6380
REDIS_PASSWORD=
REDIS_DB=0

# 每台 Gateway 必须唯一
GATEWAY_ID=gw-app-2

# Gateway 仍是 sqlite-only（本地 auth/store，不是 Prisma）。
# 必须显式设置节点本地文件，否则 Gateway 拒绝启动。
# 禁止 /app/data/cqim.db，禁止 NFS 共享。双机各用各的本地文件。
# DB_PATH=/var/lib/cqim/gateway-local.db

# 宿主机附件目录（不要把 .db 放这里做双机共享）
SHARED_DATA_DIR=/home/ubuntu/cqim_shared/data
