POSTGRES_PASSWORD=neomsg_dev
JWT_SECRET=change-me-in-production-use-long-random-string
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# MTProto 2.0 网关（docker-compose.mtproto.yaml）
